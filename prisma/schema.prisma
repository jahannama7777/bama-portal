datasource db {
  provider = "sqlite" // یا postgresql بر اساس فایل .env شما
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  fullName   String
  department String?    @default("فناوری اطلاعات")
  password   String
  role       String     @default("USER") // USER, ADMIN, SUPERADMIN
  createdAt  DateTime   @default(now())

  sessions   Session[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Application {
  id        Int      @id @default(autoincrement())
  titleFa   String
  titleEn   String?
  desc      String?
  icon      String
  url       String
  href      String?
  roles     String   @default("[\"USER\",\"ADMIN\",\"SUPERADMIN\"]")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id         Int      @id @default(autoincrement())
  title      String
  desc       String
  date       String
  type       String   @default("info") // info, warning, success, danger
  badge      String?  @default("اطلاعیه")
  badgeColor String   @default("blue")
  createdAt  DateTime @default(now())
}

model Stat {
  id        Int      @id @default(autoincrement())
  title     String
  value     String
  icon      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
